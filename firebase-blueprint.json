{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product item available in the Maknuts store",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique product ID" },
        "name": { "type": "string", "description": "Product display name" },
        "tagline": { "type": "string", "description": "Short marketing subtitle" },
        "price": { "type": "number", "description": "Current selling price in INR" },
        "originalPrice": { "type": "number", "description": "MRP strikethrough price in INR" },
        "weight": { "type": "string", "description": "Package weight or size" },
        "shortDescription": { "type": "string", "description": "Brief description of the product" },
        "fullDescription": { "type": "string", "description": "Detailed description" },
        "image": { "type": "string", "description": "Image URL or base64 data string" },
        "inStock": { "type": "boolean", "description": "Stock availability flag" },
        "stockStatusText": { "type": "string", "description": "Human-readable stock status" },
        "badge": { "type": "string", "description": "Promotional badge text" },
        "highlights": { "type": "array", "description": "List of key health benefits" }
      },
      "required": ["id", "name", "price", "weight", "image", "inStock"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global store settings, payment details and policies",
      "type": "object",
      "properties": {
        "shopName": { "type": "string", "description": "Brand/shop name" },
        "tagline": { "type": "string", "description": "Brand slogan" },
        "logoText": { "type": "string", "description": "Short logo badge text" },
        "bannerText": { "type": "string", "description": "Announcement banner text" },
        "bannerVisible": { "type": "boolean", "description": "Whether announcement banner is visible" },
        "deliveryCharge": { "type": "number", "description": "Standard delivery fee in INR" },
        "freeDeliveryThreshold": { "type": "number", "description": "Order amount for free delivery" },
        "upiId": { "type": "string", "description": "Manual UPI payment ID" },
        "upiPayeeName": { "type": "string", "description": "Payee name for UPI QR" },
        "enableUpi": { "type": "boolean", "description": "Whether UPI payment option is enabled" },
        "enableCod": { "type": "boolean", "description": "Whether Cash on Delivery is enabled" },
        "whatsappNumber": { "type": "string", "description": "WhatsApp number for orders" },
        "supportPhone": { "type": "string", "description": "Support phone number" },
        "supportEmail": { "type": "string", "description": "Support email address" },
        "address": { "type": "string", "description": "Business physical address" },
        "buttons": { "type": "object", "description": "Customizable button labels" },
        "policies": { "type": "object", "description": "Store terms, privacy, returns policies" }
      },
      "required": ["shopName", "upiId", "whatsappNumber"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order record placed through the store",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order internal document ID" },
        "orderNumber": { "type": "string", "description": "Human-readable order sequence ID" },
        "customerName": { "type": "string", "description": "Customer full name" },
        "phone": { "type": "string", "description": "10-digit customer mobile number" },
        "address": { "type": "string", "description": "Full delivery address" },
        "pincode": { "type": "string", "description": "6-digit postal PIN code" },
        "productId": { "type": "string", "description": "Purchased product ID" },
        "productName": { "type": "string", "description": "Purchased product name" },
        "productWeight": { "type": "string", "description": "Package weight of the item" },
        "quantity": { "type": "number", "description": "Purchased quantity" },
        "unitPrice": { "type": "number", "description": "Price per unit in INR" },
        "subtotal": { "type": "number", "description": "Order subtotal in INR" },
        "deliveryCharge": { "type": "number", "description": "Delivery charge in INR" },
        "totalAmount": { "type": "number", "description": "Total payable amount in INR" },
        "paymentMethod": { "type": "string", "enum": ["upi", "cod"], "description": "Selected payment method" },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Verification Required", "Paid / Verified", "Failed", "Refunded", "COD Pending", "COD Collected"], "description": "Payment verification status" },
        "upiRefNumber": { "type": "string", "description": "Optional UPI UTR reference number" },
        "paymentScreenshot": { "type": "string", "description": "Optional payment screenshot data" },
        "note": { "type": "string", "description": "Optional delivery instructions" },
        "createdAt": { "type": "string", "description": "Order ISO timestamp" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Shipped", "Delivered", "Cancelled"], "description": "Fulfillment status" }
      },
      "required": ["orderNumber", "customerName", "phone", "address", "pincode", "productName", "quantity", "totalAmount", "paymentMethod", "createdAt", "status"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Customer feedback and reviews submitted via the feedback form",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique feedback ID" },
        "customerName": { "type": "string", "description": "Customer name" },
        "phone": { "type": "string", "description": "Customer phone or WhatsApp number" },
        "email": { "type": "string", "description": "Customer email" },
        "orderId": { "type": "string", "description": "Optional associated order ID" },
        "rating": { "type": "number", "description": "Rating out of 5 stars" },
        "category": { "type": "string", "description": "Feedback category" },
        "message": { "type": "string", "description": "Detailed feedback message or suggestion" },
        "originalComment": { "type": "string", "description": "Original customer text if edited by admin" },
        "adminEditedAt": { "type": "string", "description": "Timestamp when admin modified comment" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Moderation status" },
        "verifiedBuyer": { "type": "boolean", "description": "Whether reviewer was verified against a delivered order" },
        "storeReply": { "type": "string", "description": "Public store response from admin" },
        "storeReplyAt": { "type": "string", "description": "Timestamp of public store response" },
        "photo": { "type": "string", "description": "Optional customer image attachment" },
        "createdAt": { "type": "string", "description": "Submission ISO timestamp" }
      },
      "required": ["id", "customerName", "rating", "message", "status", "createdAt"]
    },
    "OrderTracking": {
      "title": "OrderTracking",
      "description": "Sanitized customer order tracking record accessed by exact Order ID and registered mobile number",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Composite tracking ID (orderNumber_phone10)" },
        "orderNumber": { "type": "string", "description": "Human-readable order sequence ID" },
        "phoneLast4": { "type": "string", "description": "Last 4 digits of phone number for verification" },
        "createdAt": { "type": "string", "description": "Order creation ISO timestamp" },
        "productId": { "type": "string", "description": "Purchased product ID" },
        "productName": { "type": "string", "description": "Purchased product name" },
        "productWeight": { "type": "string", "description": "Package weight of the item" },
        "quantity": { "type": "number", "description": "Purchased quantity" },
        "unitPrice": { "type": "number", "description": "Unit price in INR" },
        "deliveryCharge": { "type": "number", "description": "Delivery charge in INR" },
        "totalAmount": { "type": "number", "description": "Total payable amount in INR" },
        "paymentMethod": { "type": "string", "enum": ["upi", "cod"], "description": "Selected payment method" },
        "paymentStatus": { "type": "string", "enum": ["Pending", "Verification Required", "Paid / Verified", "Failed", "Refunded", "COD Pending", "COD Collected"], "description": "Payment verification status" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Shipped", "Delivered", "Cancelled"], "description": "Fulfillment status" },
        "courierName": { "type": "string", "description": "Courier company name" },
        "trackingNumber": { "type": "string", "description": "AWB / courier tracking number" },
        "trackingUrl": { "type": "string", "description": "Direct tracking web portal link" },
        "estimatedDelivery": { "type": "string", "description": "Estimated delivery date text" },
        "statusNotes": { "type": "string", "description": "Status updates or courier remarks" }
      },
      "required": ["id", "orderNumber", "createdAt", "productName", "quantity", "totalAmount", "paymentMethod", "status"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products available in the store"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store configuration and policies"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer order records"
    },
    "/orderTracking/{trackingId}": {
      "schema": { "$ref": "#/entities/OrderTracking" },
      "description": "Sanitized customer order tracking records"
    },
    "/feedbacks/{feedbackId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "Customer feedback submissions"
    }
  }
}
